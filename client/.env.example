# LocalFlux Client Environment Configuration

# Backend game server URL (Required for online production deployments)
# Example: https://localflux-server.up.railway.app
VITE_BACKEND_URL=http://localhost:3000

# Public application URL (Used for sharing links and landing page CTA)
# Example: https://app.localflux.app
VITE_APP_URL=http://localhost:5173
