# LocalFlux Server Environment Configuration

# Server HTTP & Socket.IO Port
PORT=3000

# Client Dev Port (for local LAN IP detection log output)
CLIENT_PORT=5173

# Allowed CORS Origin for production (e.g., https://app.localflux.app)
ALLOWED_ORIGIN=*

# Host Security Password (Required for online remote host login)
HOST_PASSWORD=change_this_to_a_secure_password

# State Persistence Adapter Mode: 'memory' (offline LAN default) or 'redis' (online cloud)
STORAGE_MODE=memory

# Redis Connection URL (Required if STORAGE_MODE=redis)
# REDIS_URL=redis://default:password@localhost:6379

# Cloudflare R2 / AWS S3 Object Storage Credentials (Optional, for online uploaded image persistence)
# R2_BUCKET=localflux-assets
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
